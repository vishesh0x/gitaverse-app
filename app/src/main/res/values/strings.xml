    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_intro">GitaVerse is made to be private. This is a plain summary of how the app treats your information.</string>
    <string name="privacy_h_collect">What we collect</string>
    <string name="privacy_b_collect">Nothing. GitaVerse has no accounts, no ads, no analytics and no crash reporting, and the app has no permission to use the internet. We never receive anything you read, save or write.</string>
    <string name="privacy_h_device">What stays on your phone</string>
    <string name="privacy_b_device">Your name (if you add one), reading progress, streak, saved verses, collections, notes and settings are kept only on your phone, inside the app. They are removed when you uninstall the app or clear its storage, and they are not part of Android’s cloud backup.</string>
    <string name="privacy_h_notifications">Notifications</string>
    <string name="privacy_b_notifications">If you turn on the daily reminder, the app asks for permission to show notifications. The reminder is scheduled on your phone and nothing is sent anywhere.</string>
    <string name="privacy_h_sharing">Sharing, backups and exports</string>
    <string name="privacy_b_sharing">When you share a verse or your notes, or save a backup file, the text goes only to the app or place you choose. GitaVerse does not see or keep a copy. Keep backup files safe: they hold your notes as plain text.</string>
    <string name="privacy_h_children">Children</string>
    <string name="privacy_b_children">GitaVerse does not collect personal information from anyone, including children.</string>
    <string name="privacy_h_changes">Changes</string>
    <string name="privacy_b_changes">If this ever changes, the app and its store page will say so before the change takes effect.</string>
    <string name="privacy_read_online">Read the full policy online</string>
    <string name="terms_title">Terms and disclaimer</string>
    <string name="terms_intro">By using GitaVerse you agree to the points below. Please read them once.</string>
    <string name="terms_h_use">Using the app</string>
    <string name="terms_b_use">GitaVerse is free for personal reading, study and reflection. Please do not copy the content of the app in bulk or sell it.</string>
    <string name="terms_h_content">About the text</string>
    <string name="terms_b_content">The Sanskrit verses are ancient, but the transliteration, translations and word meanings are the work of their authors, named in Credits and licences. A translation is an interpretation and can differ from another translator’s. For serious study, please read the original text with a teacher you trust.</string>
    <string name="terms_h_advice">Not advice</string>
    <string name="terms_b_advice">The app is for reading and reflection. It is not medical, legal, financial or mental-health advice.</string>
    <string name="terms_h_warranty">No warranty</string>
    <string name="terms_b_warranty">The app is provided as it is, without promises of any kind. We work to keep it correct and running, but cannot promise that it is free of mistakes.</string>
    <string name="terms_h_licences">Licences</string>
    <string name="terms_b_licences">The code of the app is open source under the MIT License. The fonts, libraries and verse text have their own licences, shown in Credits and licences.</string>
